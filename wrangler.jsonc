{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "jantokic-com",
	"compatibility_date": "2026-10-05",
	// Static export served from the edge. worker.ts only runs for the CV PDFs to count downloads.
	"main": "worker.ts",
	"assets": {
		"directory": "./out",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
		"run_worker_first": ["/cv_*"]
	},
	"analytics_engine_datasets": [{ "binding": "CV_DOWNLOADS", "dataset": "cv_downloads" }],
	"observability": { "enabled": true }
}
